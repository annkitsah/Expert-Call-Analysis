# Required to run analysis and ask questions. Create a key at https://console.groq.com/keys
# Never commit the real .env.
GROQ_API_KEY=put_your_own_key_here

# Optional overrides
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# MAX_OUTPUT_TOKENS=8000
# LLM_TIMEOUT_S=120
# LLM_MAX_CONCURRENCY=4
# FULL_CONTEXT_TOKEN_BUDGET=60000   # above this, Q&A switches to BM25 retrieval
# RETRIEVAL_TOP_K=24
